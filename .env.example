# Voorbeeld-secrets. Kopieer naar `.env` en vul in.
#   cp .env.example .env
#
# `.env` staat in .gitignore en mag NOOIT gecommit worden.
# In productie (Streamlit Cloud, GitHub Actions) horen deze waarden in de
# secrets-store van dat platform, niet in een bestand.

# ---------------------------------------------------------------- verkeersketen
# Google Maps Platform, met de Routes API aangezet en facturering actief.
# Zonder actieve facturering antwoordt computeRoutes met 403.
# Kosten: TRAFFIC_AWARE_OPTIMAL valt in de Compute Routes Pro-SKU
# (~$10 per 1.000 aanroepen, 5.000 gratis events per maand).
GOOGLE_MAPS_API_KEY=

# TomTom developer key (gratis staffel: 2.500 non-tile requests per dag).
# https://developer.tomtom.com/
TOMTOM_API_KEY=

# HERE REST-key (gratis staffel: 250.000 transacties per maand).
# https://www.here.com/get-started/pricing
HERE_API_KEY=

# alerts.in.ua — luchtalarm per oblast en hromada. Gratis token op aanvraag.
# Nodig vanaf Fase 2. Alarmen zijn niet met terugwerkende kracht op te halen,
# dus dit token moet er zijn vóórdat de verzameling start.
ALERTS_IN_UA_TOKEN=

# NASA FIRMS — satelliet-warmtedetecties als kandidaat-inslagen.
# Gratis MAP_KEY per e-mail: https://firms.modaps.eosdis.nasa.gov/api/area/
# Wordt ook al door connectors/firms.py gebruikt.
FIRMS_MAP_KEY=

# ---------------------------------------------------------------- SENTINEL-app
# Alleen nodig voor de Streamlit-tool zelf, niet voor de verkeersketen.
# ANOMALY_PASSWORD=
# DATABASE_URL=
# ACLED_API_KEY=
